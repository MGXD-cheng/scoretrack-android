<?xml version="1.0" encoding="utf-8"?>
<!--
    自适应图标前景：一条上升的折线 + 一个端点。

    设计上只保留两个元素，其余全部砍掉：

    1. **没有基线**。上一版在底部画了一条「地面」，但自适应图标在桌面上
       其实只有 48dp 左右，那条线到最后就是一抹灰，纯属噪音。

    2. **折线只有两段**（三个点）。四个点在小尺寸下会糊成一团波浪，
       而两段已经足够表达「在往上走」。

    3. **斜率是先缓后陡的**（30,71 → 52,58 → 76,34）。
       第一段平缓、第二段陡峭，视觉上是「加速向上」；
       反过来先陡后缓会读成「后劲不足」。

    4. **端点圆比线宽略大**（半径 7.5 vs 线宽一半 4），
       给视线一个明确的落点。去掉它会显得整张图没画完。

    所有路径收在 30~84 之间，安全区是中间的 66×66（21~87）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M30,71 L52,58 L76,34"
        android:strokeWidth="8"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M76,34 m-7.5,0 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0"
        android:fillColor="#FFFFFF" />
</vector>