    从左上到右下由深到浅 —— 比纯色多一层体积感，而且在圆形、方形、
    圆角方形三种裁切下都不会出现「一片死蓝」的观感。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item
                    android:color="#1E4FD1"
                    android:offset="0.0" />
                <item
                    android:color="#2A6DF4"
                    android:offset="0.55" />
                <item
                    android:color="#5B8DEF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>