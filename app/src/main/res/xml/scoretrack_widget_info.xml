<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件配置。

  initialLayout 指向**我们自己的** widget_scoretrack（不再是 Glance 的
  glance_default_loading_layout）。之前那个 loading 占位图是 Glance 库内部
  资源，一旦组合失败就永远停在那一帧 —— 用户看到的就是不停转圈。
  现在初始布局就是最终布局（各 TextView 先空着），渲染成功即覆盖。

  minWidth/minHeight 按 2x2 算；resizeMode 允许拉宽到 4x2。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_scoretrack"
    android:minHeight="110dp"
    android:minWidth="180dp"
    android:previewLayout="@layout/widget_scoretrack"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />