<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件布局（RemoteViews）。

  这里刻意只用 LinearLayout + TextView：
  RemoteViews 支持的视图类型是白名单，加个 ConstraintLayout 之类的
  在真机上会静默变成空白 —— 而空白比报错更难查。

  ID 和 ScoreTrackWidgetProvider 里的 setTextViewText 一一对应，
  少一个 ID 那边直接抛 IllegalArgumentException。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 标题行：档案名 + 刷新 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/brand_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="↻"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 今天的一句激励 -->
    <TextView
        android:id="@+id/widget_encourage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="3"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 最近一次考试 -->
    <TextView
        android:id="@+id/widget_exam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />

    <!-- 目标差距 -->
    <TextView
        android:id="@+id/widget_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />

    <!-- 下一步 -->
    <TextView
        android:id="@+id/widget_plan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp" />
</LinearLayout>
